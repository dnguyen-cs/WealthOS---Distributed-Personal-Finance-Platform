# WealthSim compute worker. Same base as Dockerfile.app, but the entry is
# the queue-polling worker instead of the Next.js dev server, and no
# Prisma client is generated (the worker is stateless: SQS + S3 only).
# This image is what later gets pushed to ECR and run by AWS Batch.
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src

CMD ["pnpm", "worker"]
