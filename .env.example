# Postgres (docker-compose service `db`, host port 5434 to avoid clashing with native Postgres on 5432/5433)
DATABASE_URL=postgresql://wealthos:wealthos@localhost:5434/wealthos

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Plaid Sandbox — from https://dashboard.plaid.com (Team Settings -> Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# AES-256-GCM key for encrypting Plaid access tokens — generate with: openssl rand -hex 32
PLAID_TOKEN_ENC_KEY=

# WealthSim queue + object storage.
# Local dev uses emulators from docker-compose (ElasticMQ for SQS, MinIO for S3);
# for real AWS: drop both *_ENDPOINT overrides and use the Terraform outputs +
# real credentials instead.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SQS_ENDPOINT=http://localhost:9324
WEALTHSIM_QUEUE_URL=http://localhost:9324/000000000000/wealthsim-jobs
WEALTHSIM_QUEUE_URL_GO=http://localhost:9324/000000000000/wealthsim-jobs-go
S3_ENDPOINT=http://localhost:9000
WEALTHSIM_BUCKET=wealthsim-local

# PortfolioPulse stream + table.
# Local dev uses emulators from docker-compose (kinesis-mock `stream`,
# dynamodb-local `table`); for real AWS drop both *_ENDPOINT overrides.
KINESIS_ENDPOINT=http://localhost:4568
DYNAMODB_ENDPOINT=http://localhost:8000
PULSE_STREAM=pulse-events
PULSE_TABLE=pulse

# App coordination state (rate-limit windows, daily budgets, Plaid sync
# lock) lives in the `app-state` DynamoDB table - dynamodb-local serves it
# locally through the same DYNAMODB_ENDPOINT override; no Redis anywhere.
# APP_STATE_TABLE=app-state

# Abuse guards on the public run/auth endpoints (all optional; defaults shown).
# The hosted demo tightens these; local dev can leave them unset.
# WEALTHSIM_MAX_PATHS=10000000          # per-job path cap (absolute schema max 10M)
# WEALTHSIM_RUNS_PER_MINUTE=6           # per-user submissions per minute
# WEALTHSIM_DAILY_PATH_BUDGET=1000000000  # global paths/day across all users (UTC reset)
