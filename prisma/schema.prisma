generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String?
  createdAt      DateTime        @default(now())
  plaidItems     PlaidItem[]
  simulationJobs SimulationJob[]
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId          String    @unique
  encryptedAccessToken String
  institutionName      String?
  syncCursor           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  accounts             Account[]
}

model Account {
  id               String        @id @default(cuid())
  plaidItemId      String
  item             PlaidItem     @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Decimal       @db.Decimal(18, 2)
  availableBalance Decimal?      @db.Decimal(18, 2)
  isoCurrencyCode  String        @default("USD")
  transactions     Transaction[]
}

model Transaction {
  id                 String   @id @default(cuid())
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId String   @unique
  amount             Decimal  @db.Decimal(18, 2)
  date               DateTime @db.Date
  name               String
  merchantName       String?
  category           String?
  pending            Boolean  @default(false)
  isoCurrencyCode    String   @default("USD")

  @@index([accountId, date])
}

enum SimulationJobStatus {
  queued
  running
  completed
  failed
}

// Chunk-level results are not stored here: workers write per-chunk
// summaries to object storage, and only the final aggregate lands in
// Postgres. Workers therefore need no database access at all.
model SimulationJob {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      SimulationJobStatus @default(queued)
  params      Json
  pathCount   Int
  chunkCount  Int
  chunkSize   Int
  seed        Int
  error       String?
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  result      SimulationResult?

  @@index([userId, createdAt])
}

model SimulationResult {
  id             String        @id @default(cuid())
  jobId          String        @unique
  job            SimulationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  yearlyStats    Json
  pathsCompleted Int
  totalComputeMs Int
  wallMs         Int
  createdAt      DateTime      @default(now())
}
